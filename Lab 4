        }
        button {
            background: #474747;
            color: white;
            border: none;
            padding: 6px 12px;
            cursor: pointer;
            font-family: monospace;
            font-size: 14px;
        }
        button:hover {
            background: #575858;
        }
        hr {
            border: none;
            border-top: 1px solid #ddd;
        }
